{
	"name": "web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "pnpm --workspace-root turbo run build --filter=cstd-next",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --experimental-next-config-strip-types",
		"prebuild": "cstd-next-clean-images",
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --experimental-next-config-strip-types",
		"postbuild": "cstd-next-finalize-images",
		"build:worker": "opennextjs-cloudflare build --skipNextBuild",
		"start": "next start --experimental-next-config-strip-types",
		"preview": "pnpm --workspace-root build:worker && opennextjs-cloudflare preview",
		"deploy": "pnpm run deploy:database && pnpm run deploy:app && pnpm run deploy:reminders",
		"deploy:app": "pnpm --workspace-root build:worker && OPEN_NEXT_DEPLOY=true wrangler deploy",
		"deploy:preview": "pnpm --workspace-root build:worker && OPEN_NEXT_DEPLOY=true wrangler deploy --env preview",
		"upload": "pnpm --workspace-root build:worker && OPEN_NEXT_DEPLOY=true wrangler versions upload",
		"deploy:database": "cross-env NODE_ENV=production CLOUDFLARE_REMOTE_BINDINGS=true PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --remote",
		"deploy:database:preview": "cross-env NODE_ENV=production CLOUDFLARE_ENV=preview CLOUDFLARE_REMOTE_BINDINGS=true PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --env preview --command 'PRAGMA optimize' --remote",
		"migrate:local": "cross-env PAYLOAD_SECRET=local-ci-secret payload migrate",
		"seed:local": "cross-env PAYLOAD_SECRET=local-ci-secret SEED_CMS=true tsx scripts/seed-ci.ts",
		"seed:preview": "cross-env NODE_ENV=production CLOUDFLARE_ENV=preview CLOUDFLARE_REMOTE_BINDINGS=true SEED_CMS=true tsx scripts/seed-ci.ts",
		"build:opennext": "pnpm --workspace-root build:worker",
		"deploy:reminders": "wrangler deploy --config wrangler.reminders.jsonc",
		"logs": "wrangler tail",
		"logs:preview": "wrangler tail --env preview",
		"shadcn:search": "cstd-shadcn-search",
		"shadcn:add": "cstd-shadcn-add",
		"shadcn:patch": "cstd-shadcn-patch",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
		"generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"check": "pnpm check-biome && pnpm check-types",
		"check-types": "tsc --noEmit",
		"check-biome": "biome check --error-on-warnings",
		"check-biome-staged": "biome check --error-on-warnings --staged --no-errors-on-unmatched",
		"check-biome-fix": "biome check --error-on-warnings --fix",
		"test:unit": "vitest run",
		"test:e2e": "node scripts/run-e2e.mjs",
		"clean": "rm -rf .next .open-next .wrangler public/_cstd/image",
		"postinstall": "[ \"${CI:-}\" = true ] || next telemetry disable"
	},
	"dependencies": {
		"@base-ui/react": "^1.1.0",
		"@block65/webcrypto-web-push": "^1.0.2",
		"@fullcalendar/core": "^6.1.21",
		"@fullcalendar/daygrid": "^6.1.21",
		"@fullcalendar/interaction": "^6.1.21",
		"@fullcalendar/list": "^6.1.21",
		"@fullcalendar/react": "^6.1.21",
		"@fullcalendar/timegrid": "^6.1.21",
		"@opennextjs/cloudflare": "^1.20.2",
		"@payloadcms/db-d1-sqlite": "3.88.0",
		"@payloadcms/next": "3.88.0",
		"@payloadcms/richtext-lexical": "3.88.0",
		"@payloadcms/storage-r2": "3.88.0",
		"@payloadcms/translations": "3.88.0",
		"@payloadcms/ui": "3.88.0",
		"@pro-laico/payload-revalidate": "0.8.5",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.3",
		"@t3-oss/env-nextjs": "^0.13.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cross-env": "10.1.0",
		"cstd-next": "workspace:*",
		"cstd-ts": "workspace:*",
		"drizzle-orm": "0.45.2",
		"graphql": "^16.8.1",
		"lucide-react": "^0.474.0",
		"next": "16.3.3",
		"next-themes": "^0.4.6",
		"nuqs": "^2.5.2",
		"payload": "3.88.0",
		"qrcode.react": "^4.2.0",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"react-easy-crop": "6.2.3",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.1.13",
		"@types/node": "^24.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"babel-plugin-react-compiler": "1.0.0",
		"esbuild": "0.28.2",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.1.13",
		"tsx": "^4.22.4",
		"typescript": "^5.9.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.123.0"
	}
}
