{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "showteam-migrations",
	"compatibility_date": "2025-08-15",
	"d1_databases": [
		{
			"binding": "D1",
			"database_id": "fb4ccca4-31e6-4ed0-b3e5-a36b520d89c6",
			"database_name": "showteam-cms",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "showteam-media",
			"remote": true
		}
	],
	"env": {
		"preview": {
			"d1_databases": [
				{
					"binding": "D1",
					"database_id": "f5fa2b42-977f-4048-8fae-8be5f19fefea",
					"database_name": "showteam-preview-cms",
					"remote": true
				}
			],
			"r2_buckets": [{ "binding": "R2", "bucket_name": "showteam-preview-media", "remote": true }]
		}
	}
}
