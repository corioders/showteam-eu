{
	"dependencies": {
		"@jsquash/avif": "2.1.1",
		"@jsquash/resize": "2.1.1",
		"@jsquash/webp": "1.5.0",
		"cstd-ts": "workspace:*",
		"http-status-codes": "^2.3.0",
		"p-limit": "^6.2.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"server-only": "^0.0.1",
		"sharp": "^0.35.3",
		"svgo": "^4.0.0",
		"typescript": "^5.9.2",
		"undici": "^7.13.0",
		"unstorage": "^1.16.1"
	},
	"bin": {
		"cstd-next-clean-images": "./script/clean-prerendered-image-output.js",
		"cstd-next-finalize-images": "./script/finalize-prerendered-image-build.js"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"concurrently": "^9.2.0",
		"next": "16.3.3",
		"tsc-alias": "^1.8.16",
		"vitest": "^4.1.11"
	},
	"exports": {
		"./*": "./build/*"
	},
	"imports": {
		"#cstd-next-prerendered-image-runtime": {
			"types": "./src/media/image/prerendered-image-runtime.ts",
			"default": "./build/media/image/prerendered-image-runtime.js"
		}
	},
	"name": "cstd-next",
	"type": "module",
	"packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
	"peerDependencies": {
		"@types/react": "*",
		"@types/react-dom": "*",
		"firebase": "*",
		"googleapis": "*",
		"next": "16.3.3",
		"react": "*",
		"react-dom": "*"
	},
	"scripts": {
		"build": "pnpm run clean && tsc && tsc-alias",
		"build-cloudflare": "pnpm run build",
		"check": "pnpm check-biome && pnpm check-types",
		"check-biome": "biome check --config-path biome.jsonc --error-on-warnings",
		"check-biome-staged": "biome check --config-path biome.jsonc --error-on-warnings --staged --no-errors-on-unmatched",
		"check-types": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
		"clean": "rm -rf build",
		"dev": "concurrently \"tsc --watch --preserveWatchOutput\" \"tsc-alias --watch\"",
		"test:unit": "vitest run"
	},
	"version": "0.0.0"
}
