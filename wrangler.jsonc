{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "showteam-eu",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/admin*", "/api/*", "/dodaj*", "/tv*", "/kalendarz*", "/polacz-tv*", "/rezerwacje*", "/oferta/*", "/kontakt"]
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "fb4ccca4-31e6-4ed0-b3e5-a36b520d89c6",
      "database_name": "showteam-cms"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "showteam-media"
    }
  ],
  "env": {
    "migrations": {
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "fb4ccca4-31e6-4ed0-b3e5-a36b520d89c6",
          "database_name": "showteam-cms",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "showteam-media",
          "remote": true
        }
      ]
    }
  }
}
