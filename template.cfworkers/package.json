{
	"name": "template.cfworkers",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"postinstall": "lefthook install && turbo telemetry disable",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check": "pnpm check-biome && pnpm check-types",
		"check-types": "turbo run check-types",
		"check-biome": "biome check --error-on-warnings",
		"check-biome-staged": "biome check --error-on-warnings --staged --no-errors-on-unmatched",
		"check-biome-fix": "biome check --error-on-warnings --fix",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "turbo run test:unit",
		"test:e2e": "turbo run test:e2e",
		"clean": "turbo run clean && rm -rf .turbo"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"lefthook": "^2.1.0",
		"turbo": "^2.8.3"
	},
	"packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
