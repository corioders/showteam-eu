{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["dom", "dom.iterable", "esnext"],
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@payload-config": ["./payload.config.ts"]
		},
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"exclude": ["node_modules", "corioders-lib/**", ".next", ".vercel"],
	"extends": "./../../packages/corioders-lib/cstd-ts/config/tsconfig.json",
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"]
}
