{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "template-cfworkers-web",
	"compatibility_date": "2026-05-05",
	"compatibility_flags": [
		// Enable Node.js API
		// see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
		"nodejs_compat",
		// Allow to fetch URLs in your app
		// see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
		"global_fetch_strictly_public"
	],
	"vars": {
		"APP_ENV": "production"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": ["/admin*", "/api/*"]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 0.1
		}
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			// The service must match the "name" of this worker
			"service": "template-cfworkers-web"
		},
		{
			"binding": "CORIODERS_TELEMETRY",
			"service": "corioders-dashboard-cfworkers-web",
			"remote": true
		}
	],
	"r2_buckets": [
		// REQUIRED: incremental cache for Next.js. Keep this binding and append application buckets.
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "template-cfworkers-next-inc-cache-r2-bucket"
		},
		{
			"binding": "PAYLOAD_MEDIA",
			"bucket_name": "template-cfworkers-payload-media-r2"
		}
	],
	"d1_databases": [
		// REQUIRED: tag cache backing revalidateTag/revalidatePath. Keep this binding and append application databases.
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
			"database_name": "template-cfworkers-next-tag-cache-d1"
		},
		{
			"binding": "PAYLOAD_DB",
			"database_id": "REPLACE_WITH_PRODUCTION_PAYLOAD_D1_DATABASE_ID",
			"database_name": "template-cfworkers-payload-d1"
		}
	],
	// Custom domain, uncomment and set once DNS is on Cloudflare.
	// "routes": [{ "pattern": "example.com", "custom_domain": true }],
	"env": {
		"preview": {
			"workers_dev": true,
			"preview_urls": true,
			"vars": {
				"APP_ENV": "preview"
			},
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"invocation_logs": true,
					"head_sampling_rate": 1
				}
			},
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS",
				"run_worker_first": ["/admin*", "/api/*"]
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "template-cfworkers-web-preview"
				},
				{
					"binding": "CORIODERS_TELEMETRY",
					"service": "corioders-dashboard-cfworkers-web"
				}
			],
			"r2_buckets": [
				// REQUIRED: preview cache. Keep it separate from every production bucket.
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "template-cfworkers-preview-next-inc-cache-r2-bucket"
				},
				{
					"binding": "PAYLOAD_MEDIA",
					"bucket_name": "template-cfworkers-preview-payload-media-r2"
				}
			],
			"d1_databases": [
				// REQUIRED: preview tag cache. Keep it separate from every production database.
				{
					"binding": "NEXT_TAG_CACHE_D1",
					"database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
					"database_name": "template-cfworkers-preview-next-tag-cache-d1"
				},
				{
					"binding": "PAYLOAD_DB",
					"database_id": "REPLACE_WITH_PREVIEW_PAYLOAD_D1_DATABASE_ID",
					"database_name": "template-cfworkers-preview-payload-d1"
				}
			]
		}
	}
	// Cloudflare image optimization binding.
	// see https://opennext.js.org/cloudflare/howtos/image
	// "images": { "binding": "IMAGES" }
}
