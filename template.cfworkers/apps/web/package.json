{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --experimental-next-config-strip-types",
		"build": "next build --experimental-next-config-strip-types",
		"start": "next start --experimental-next-config-strip-types",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"logs": "wrangler tail",
		"logs:preview": "wrangler tail --env preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"clean": "rm -rf .next .open-next .wrangler",
		"check": "pnpm check-biome && pnpm check-types",
		"check-types": "tsc --noEmit",
		"check-biome": "biome check --error-on-warnings",
		"check-biome-fix": "biome check --error-on-warnings --fix",
		"postinstall": "next telemetry disable"
	},
	"dependencies": {
		"@base-ui/react": "^1.1.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cstd-next": "workspace:*",
		"cstd-ts": "workspace:*",
		"lucide-react": "^0.474.0",
		"next": "16.3.2",
		"next-themes": "^0.4.6",
		"nuqs": "^2.5.2",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@opennextjs/cloudflare": "^1.20.2",
		"@tailwindcss/postcss": "^4.1.13",
		"@types/node": "^24.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"babel-plugin-react-compiler": "1.0.0",
		"sharp": "^0.34.5",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"wrangler": "^4.100.0"
	}
}
