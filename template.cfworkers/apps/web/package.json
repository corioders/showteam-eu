{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "pnpm --workspace-root turbo run build --filter=cstd-next",
		"dev": "next dev --experimental-next-config-strip-types",
		"prebuild": "cstd-next-clean-images",
		"build": "next build --experimental-next-config-strip-types",
		"postbuild": "cstd-next-finalize-images",
		"build:worker": "opennextjs-cloudflare build --skipNextBuild",
		"start": "next start --experimental-next-config-strip-types",
		"preview": "pnpm --workspace-root build:worker && opennextjs-cloudflare preview",
		"deploy": "pnpm --workspace-root build:worker && OPEN_NEXT_DEPLOY=true wrangler deploy",
		"deploy:preview": "pnpm --workspace-root build:worker && OPEN_NEXT_DEPLOY=true wrangler deploy --env preview",
		"upload": "pnpm --workspace-root build:worker && OPEN_NEXT_DEPLOY=true wrangler versions upload",
		"logs": "wrangler tail",
		"logs:preview": "wrangler tail --env preview",
		"shadcn:search": "cstd-shadcn-search",
		"shadcn:add": "cstd-shadcn-add",
		"shadcn:learn": "cstd-shadcn-learn",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"clean": "rm -rf .next .open-next .wrangler public/_cstd/image",
		"check": "pnpm check-biome && pnpm check-types",
		"check-types": "tsc --noEmit",
		"check-biome": "biome check --error-on-warnings",
		"check-biome-staged": "biome check --error-on-warnings --staged --no-errors-on-unmatched",
		"check-biome-fix": "biome check --error-on-warnings --fix",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"postinstall": "next telemetry disable"
	},
	"dependencies": {
		"@base-ui/react": "^1.1.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cstd-next": "workspace:*",
		"cstd-ts": "workspace:*",
		"lucide-react": "^0.474.0",
		"next": "16.3.3",
		"next-themes": "^0.4.6",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@opennextjs/cloudflare": "^1.20.4",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.1.13",
		"@types/node": "^24.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"babel-plugin-react-compiler": "1.0.0",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.100.0"
	}
}
