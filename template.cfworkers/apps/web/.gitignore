.wrangler

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.open-next
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/
/public/_cstd/image/
/cache/*
!/cache/config.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.age

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
