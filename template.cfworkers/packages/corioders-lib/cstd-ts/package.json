{
	"dependencies": {
		"@textlint/ast-node-types": "15.2.1",
		"@textlint/markdown-to-ast": "15.2.1",
		"exceljs": "^4.4.0",
		"googleapis": "^156.0.0",
		"googleapis-common": "^8.0.0",
		"http-status-codes": "^2.3.0",
		"lmdb": "^3.4.2",
		"luxon": "^3.7.1",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"memoize": "^10.1.0",
		"proper-lockfile": "^4.1.2",
		"remark": "^15.0.1",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"strip-markdown": "^6.0.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0",
		"unstorage": "^1.16.1",
		"vfile": "^6.0.3",
		"vfile-reporter": "^8.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@textlint/ast-node-types": "^14.4.2",
		"@types/luxon": "^3.7.1",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.2.1",
		"@types/proper-lockfile": "^4.1.4",
		"@types/textract": "^2.4.5",
		"concurrently": "^9.2.0",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.9.2"
	},
	"exports": {
		"./*": "./build/*"
	},
	"name": "cstd-ts",
	"type": "module",
	"packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
	"peerDependencies": {
		"firebase": "*"
	},
	"scripts": {
		"build": "tsc && tsc-alias",
		"build-cloudflare": "pnpm run build",
		"check": "pnpm check-biome && pnpm check-types",
		"check-biome": "biome check --config-path biome.jsonc --error-on-warnings",
		"check-biome-staged": "biome check --config-path biome.jsonc --error-on-warnings --staged --no-errors-on-unmatched",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf build",
		"dev": "concurrently \"tsc --watch --preserveWatchOutput\" \"tsc-alias --watch\"",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"version": "0.0.0"
}
