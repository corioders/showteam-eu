{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalEnv": [
		"APP_ENV",
		"CORIODERS_DRIVE_CMS_KEY",
		"CORIODERS_GOOGLE_FILE_UPLOAD_CMS_KEY",
		"CORIODERS_INVALIDATE_PERSISTENT_CACHE",
		"CORIODERS_DISABLE_PERFORMANCE_PLACEHOLDER",
		"NEXT_IS_EXPORT_WORKER"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "build/**"]
		},
		"check": {
			"dependsOn": ["^check"]
		},
		"check-biome": {
			"dependsOn": ["^check-biome"]
		},
		"check-biome-staged": {
			"cache": false,
			"dependsOn": ["^check-biome-staged"]
		},
		"check-biome-fix": {
			"dependsOn": ["^check-biome-fix"]
		},
		"check-types": {
			"dependsOn": ["^build", "^check-types"]
		},
		"test:unit": {
			"dependsOn": ["^build", "^test:unit"]
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["build"],
			"env": ["PLAYWRIGHT_BASE_URL", "PLAYWRIGHT_BROWSERS_PATH", "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH"],
			"outputs": ["playwright-report/**", "test-results/**"]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^build"],
			"persistent": true
		}
	}
}
