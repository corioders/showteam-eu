{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "build/**"]
		},
		"check": {
			"dependsOn": ["^check"]
		},
		"check-biome": {
			"dependsOn": ["^check-biome"]
		},
		"check-biome-fix": {
			"dependsOn": ["^check-biome-fix"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
