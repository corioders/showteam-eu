// biome-ignore-all assist/source/useSortedKeys: I want this file to be in the order presented on biome website
{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"extends": ["./packages/corioders-lib/cstd-ts/config/biome.jsonc"],
	"plugins": ["packages/corioders-lib/cstd-ts/config/biome-plugin/no-native-img.grit", "packages/corioders-lib/cstd-ts/config/biome-plugin/no-throw.grit"],
	"files": {
		"includes": [
			"!skills-lock.json",
			"!**/.agents/skills",
			"!**/node_modules",
			"!**/cache",
			"!**/dist",
			"!**/build",
			"!**/coverage",
			"!**/.git",
			"!**/.github",
			"!**/.idea",
			"!**/.vscode",
			"!**/.wrangler",
			"!script/fixtures/biome"
		]
	}
}
