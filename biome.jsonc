{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"extends": ["./config/biome.jsonc"],
	"linter": {
		"rules": {
			"correctness": {
				"useImportExtensions": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"suggestedExtensions": {
							"ts": {
								"module": "js",
								"component": "jsx"
							}
						}
					}
				}
			}
		}
	}
}
