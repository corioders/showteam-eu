// biome-ignore-all assist/source/useSortedKeys: I want this file to be in the order presented on biome website
{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"extends": ["./../cstd-ts/config/biome.jsonc"],
	"files": {
		"includes": ["!script/shadcn/patches"]
	},
	"plugins": ["../cstd-ts/config/biome-plugin/no-native-img.grit", "../cstd-ts/config/biome-plugin/no-throw.grit"],
	"linter": {
		"rules": {
			"suspicious": {
				"noExplicitAny": "off",
				"noConsole": "off"
			}
		}
	}
}
