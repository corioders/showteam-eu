{
	"extends": ["./config/tsconfig.json"],
	"compilerOptions": {
		"outDir": "build",
		"sourceRoot": "../../packages/corioders-lib/cstd-ts/src",
		"tsBuildInfoFile": "./build/tsconfig.tsbuildinfo",
		"sourceMap": true,
		"incremental": true,
		"declaration": true,
		"declarationMap": true,
		"skipLibCheck": true,
		"target": "esnext",
		"module": "esnext",
		"jsx": "preserve",
		"moduleResolution": "bundler",
		"rootDir": "src",
		"paths": {
			"@/*": ["./src/*"]
		},
		"typeRoots": ["./node_modules/@types"]
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
	"exclude": ["node_modules", "build"]
}
