{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"outDir": "build",
		"paths": {
			"@/*": ["./src/*"]
		},
		"rootDir": "src",
		"sourceMap": true,
		// "sourceRoot": "../../packages/corioders-lib/cstd-ts/src",
		"tsBuildInfoFile": "./build/tsconfig.tsbuildinfo",
		"typeRoots": ["./node_modules/@types"]
	},
	"exclude": ["node_modules", "build"],
	"extends": ["./config/tsconfig.json"],
	"include": ["**/*.ts", "**/*.tsx"]
}
