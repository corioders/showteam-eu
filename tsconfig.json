{
	"compilerOptions": {
		"outDir": "build",
		"sourceMap": true,
		"incremental": true,
		"declaration": true,
		"declarationMap": true,
		"target": "esnext",
		"module": "esnext",
		"jsx": "preserve",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "build"]
}
