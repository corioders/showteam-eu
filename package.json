{
	"name": "cstd-next",
	"version": "0.0.0",
	"packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
	"exports": {
		"./*": "./build/*"
	},
	"scripts": {
		"dev": "concurrently \"tsc --watch --preserveWatchOutput\" \"tsc-alias --watch\"",
		"build": "tsc && tsc-alias",
		"build-cloudflare": "pnpm run build",
		"clean": "rm -rf build",
		"check": "pnpm check-biome && pnpm check-types",
		"check-types": "tsc --noEmit",
		"check-biome": "biome check --error-on-warnings"
	},
	"dependencies": {
		"buffer-image-size": "^0.6.4",
		"cacheable": "^1.8.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cstd-ts": "workspace:*",
		"framer-motion": "^12.5.0",
		"http-status-codes": "^2.3.0",
		"memoize": "^10.1.0",
		"p-limit": "^6.2.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"server-only": "^0.0.1",
		"sharp": "^0.33.5",
		"svgo": "^3.3.2",
		"tailwind-merge": "^3.0.2",
		"undici": "^7.4.0",
		"unstorage": "^1.15.0"
	},
	"devDependencies": {
		"concurrently": "^9.0.1",
		"tsc-alias": "^1.8.10",
		"typescript": "^5.6.2"
	},
	"peerDependencies": {
		"@types/react": "*",
		"firebase": "*",
		"googleapis": "*",
		"next": "*",
		"react": "*",
		"webpack": "*"
	}
}
