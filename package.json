{
	"name": "cstd-ts",
	"version": "0.0.0",
	"packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
	"exports": {
		"./*": "./build/*"
	},
	"scripts": {
		"dev": "concurrently \"tsc --watch --preserveWatchOutput\" \"tsc-alias --watch\"",
		"build": "tsc && tsc-alias",
		"build-cloudflare": "pnpm run build",
		"clean": "rm -rf build",
		"check": "pnpm check-biome && pnpm check-types",
		"check-types": "tsc --noEmit",
		"check-biome": "biome check --error-on-warnings"
	},
	"dependencies": {
		"@textlint/ast-node-types": "14.4.2",
		"@textlint/markdown-to-ast": "14.4.2",
		"buffer-image-size": "^0.6.4",
		"googleapis": "^148.0.0",
		"googleapis-common": "^7.2.0",
		"http-status-codes": "^2.3.0",
		"luxon": "^3.5.0",
		"memoize": "^10.1.0",
		"remark": "^15.0.1",
		"strip-markdown": "^6.0.0",
		"unstorage": "^1.15.0",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@textlint/ast-node-types": "^14.4.2",
		"@types/luxon": "^3.4.2",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.7.5",
		"@types/textract": "^2.4.5",
		"concurrently": "^9.0.1",
		"tsc-alias": "^1.8.10",
		"typescript": "^5.6.2"
	},
	"peerDependencies": {
		"firebase": "*"
	}
}
