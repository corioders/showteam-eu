{
	"$schema": "./../node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"maxSize": 2097152,
		"ignore": ["corioders-lib"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 170,
		"formatWithErrors": true
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,

		"rules": {
			"all": true,
			"suspicious": {
				"noReactSpecificProps": "off",
				// AggregateError should not require a message
				"useErrorMessage": "off"
			},
			"style": {
				"noDefaultExport": "off",
				"useFilenamingConvention": {
					"level": "warn",
					"options": { "strictCase": false }
				},
				"useNamingConvention": {
					"level": "warn",
					"options": { "strictCase": false }
				},
				"useSelfClosingElements": {
					"level": "warn",
					"fix": "safe"
				},
				"noImplicitBoolean": {
					"level": "warn",
					"fix": "safe"
				}
			},
			"complexity": {
				// This rule interferes with the noPropertyAccessFromIndexSignature typescript compiler flag
				"useLiteralKeys": "off"
			},
			"correctness": {
				"useImportExtensions": {
					"level": "warn",
					"fix": "safe",
					"options": {}
				},
				"noNodejsModules": "off"
			},
			"nursery": {
				// TODO: Follow this issue: https://github.com/biomejs/biome/issues/1274
				"useSortedClasses": {
					"level": "error",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "tw", "tw.*"]
					}
				}
			},
			"a11y": {
				"noSvgWithoutTitle": "off"
			}
		}
	},
	"javascript": {
		"jsxRuntime": "reactClassic",
		"formatter": { "quoteStyle": "single" }
	}
}
