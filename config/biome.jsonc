// biome-ignore-all assist/source/useSortedKeys: I want this file to be in the order presented on biome website
{
	"$schema": "https://biomejs.dev/schemas/2.1.4/schema.json",
	"root": false,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"maxSize": 2097152,
		// Ignore the 'build' folder
		"includes": ["**", "!**/build", "!package.json"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 170,
		"formatWithErrors": false
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "all",
			"next": "all",
			"project": "all"
		},
		"rules": {
			"a11y": {},
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": { "maxAllowedComplexity": 20 }
				},
				"noUselessStringConcat": "error",
				// This rule interferes with the noPropertyAccessFromIndexSignature typescript compiler flag
				"useLiteralKeys": "off",
				"useWhile": "on"
			},
			"correctness": {
				"noUndeclaredVariables": "on",
				"noUnusedImports": {
					"level": "warn",
					"fix": "safe"
				}
				// https://next.biomejs.dev/linter/rules/use-import-extensions/
				// "useImportExtensions": {},
			},
			"nursery": {
				// "noAwaitInLoop": "info",
				"noConstantBinaryExpression": "warn",
				"noFloatingPromises": "warn",
				"noGlobalDirnameFilename": "warn",
				// Typescript struggles with type inference when using explicit coercion
				// "noImplicitCoercion": "warn",
				"noMagicNumbers": "warn",
				"noNoninteractiveElementInteractions": "warn",
				// process.env is used by nextjs to provide env information. Forcing to import process, makes this feature unusable on client-components
				// "noProcessGlobal": "warn",
				"noReactPropAssign": "warn",
				// "noSecrets": "warn",
				"noTsIgnore": "warn",
				"noUnassignedVariables": "warn",
				"noUselessBackrefInRegex": "warn",
				"noUselessEscapeInString": "warn",
				"useIndexOf": "warn",
				"useIterableCallbackReturn": "warn",
				"useNumericSeparators": "warn",
				"useObjectSpread": "warn",
				"useParseIntRadix": "warn",
				"useReadonlyClassProperties": "warn",
				"useSingleJsDocAsterisk": "warn",
				// TODO: Follow this issue: https://github.com/biomejs/biome/issues/1274
				"useSortedClasses": {
					"level": "error",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "tw", "tw.*"]
					}
				},
				"useSymbolDescription": "warn",
				"useUnifiedTypeSignature": "warn"
			},
			"performance": {
				"noBarrelFile": "warn",
				// The fix proposed by this rule is misleading
				// "noDelete": "warn",
				"noReExportAll": "warn",
				"useTopLevelRegex": "warn"
			},
			"style": {
				"noCommonJs": "warn",
				"noDefaultExport": "warn",
				"noEnum": "warn",
				"noExportedImports": "warn",
				"noImplicitBoolean": "warn",
				"noNamespace": "warn",
				"noNonNullAssertion": "warn",
				"noParameterAssign": "warn",
				"noParameterProperties": "warn",
				"noShoutyConstants": "warn",
				"noSubstr": "warn",
				"noUnusedTemplateLiteral": "warn",
				"noUselessElse": "warn",
				"noYodaExpression": "warn",
				"useAsConstAssertion": "warn",
				"useAtIndex": "warn",
				"useBlockStatements": "warn",
				"useConsistentArrayType": "warn",
				"useConsistentBuiltinInstantiation": "warn",
				"useConsistentCurlyBraces": "warn",
				"useDefaultParameterLast": "warn",
				"useExplicitLengthCheck": "warn",
				"useFilenamingConvention": {
					"level": "warn",
					"options": {
						"strictCase": false,
						"requireAscii": true,
						// "match": "%?(.+?)[.](.+)", // Since v2.0.0
						"filenameCases": ["kebab-case"]
					}
				},
				"useForOf": "warn",
				"useFragmentSyntax": "warn",
				"useNamingConvention": {
					"level": "warn",
					"options": { "strictCase": false }
				},
				"useNumberNamespace": "warn",
				"useSelfClosingElements": "warn",
				"useSingleVarDeclarator": "warn",
				"useTrimStartEnd": "warn"
			},
			"suspicious": {
				"noConsole": "warn",
				"noEvolvingTypes": "warn",
				"noVar": "warn",
				"useGuardForIn": "warn",
				"useNumberToFixedDigitsArgument": "warn"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [":NODE:", ":BLANK_LINE:", ":PACKAGE:", ":BLANK_LINE:", ":ALIAS:", ":BLANK_LINE:", ":PATH:"]
					}
				},
				"useSortedAttributes": "on",
				"useSortedKeys": "on"
			}
		}
	}
}
